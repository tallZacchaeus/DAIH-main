  }
  code {
    font-family: 'Consolas', 'Courier New', monospace;
    background-color: #EDF2F7;
    color: #C53030;
    padding: 2px 6px;
    border-radius: 3px;
    font-size: 9.5pt;
  }
  .footer-note {
    margin-top: 36px;
    border-top: 1px solid #E2E8F0;
    padding-top: 12px;
    font-size: 9pt;
    color: #718096;
