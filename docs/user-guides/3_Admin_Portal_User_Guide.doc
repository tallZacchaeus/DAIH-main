    border-radius: 8px;
    margin-bottom: 28px;
  }
  .header-card h1 {
    color: #FFFFFF;
    font-size: 24pt;
    margin: 0 0 6px 0;
    font-weight: 700;
  }
  .header-card p.subtitle {
    color: #E2E8F0;
    font-size: 13pt;
    margin: 0 0 12px 0;
  }
  .meta-badge {
    display: inline-block;
    background-color: rgba(255, 255, 255, 0.2);
