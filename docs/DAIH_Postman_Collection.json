{
  "info": {
    "_postman_id": "daih-workspace-platform-v1",
    "name": "DAIH Platform API",
    "description": "Complete Postman collection for the DAIH Platform (Express Modular Monolith API).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. System Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        }
      ]
    },
    {
      "name": "1. Identity & Authentication",
      "item": [
        {
          "name": "1.1 Login as Super Administrator",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    var token = json.data && (json.data.token || json.data.accessToken);",
                  "    if (token) {",
                  "        pm.collectionVariables.set('token', token);",
                  "        pm.environment.set('token', token);",
                  "        console.log('✅ Access Token automatically saved to {{token}}');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@daih.ng\",\n  \"password\": \"SuperAdminPassword123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/identity/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "identity", "login"]
            }
          }
        },
        {
          "name": "1.2 Register Customer Account",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"newmember@daih.ng\",\n  \"password\": \"StrongPass2026!\",\n  \"firstName\": \"Ayodele\",\n  \"lastName\": \"Ogunlesi\",\n  \"phone\": \"08012345678\",\n  \"agreedToPolicy\": true\n}"
            },
            "url": {
