# ==============================================================================
# DAIH Customer Mobile PWA - Hostinger VPS Production Template (.env.example)
# ==============================================================================

# Port (managed locally by PM2 or Docker on the VPS)
PORT=3001

# ─── API Routing & Same-Origin Proxy ─────────────────────────────────────────
# Tells the Next.js server on the VPS to proxy /api/v1 calls directly to local Express
INTERNAL_API_URL="http://127.0.0.1:4000"

# Tells the browser client to use the same-origin relative proxy path
NEXT_PUBLIC_API_URL="/api/v1"

# ─── Cross-Service Navigation ────────────────────────────────────────────────
NEXT_PUBLIC_CUSTOMER_PWA_URL="https://app.daih.ng"
NEXT_PUBLIC_WEB_URL="https://daih.ng"
NEXT_PUBLIC_ADMIN_URL="https://admin.daih.ng"

# ─── Google OAuth & Sign-In ──────────────────────────────────────────────────
# Google Client ID (Public identifier used by Google Identity Services SDK in browser)
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"

# ─── Observability (Optional) ────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
NEXT_PUBLIC_APP_ENV="production"
